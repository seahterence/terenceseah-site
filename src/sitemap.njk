---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/my-blog/</loc><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/about/</loc><priority>0.7</priority></url>
{%- for r in collections.reviews %}
  <url><loc>{{ site.url }}{{ r.url }}</loc><lastmod>{{ r.data.date | isoDate }}</lastmod><priority>0.8</priority></url>
{%- endfor %}
</urlset>
